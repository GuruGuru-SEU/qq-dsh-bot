# Official DeepSeek API key. Replace before starting the bot.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
# Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Set the same value in the gateway's reverse WebSocket token field.
ONEBOT_TOKEN=replace_with_a_random_token_at_least_32_characters
# Existing Docker network shared with your QQ gateway container.
ONEBOT_NETWORK=napcat_default
